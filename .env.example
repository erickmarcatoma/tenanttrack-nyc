# App
APP_ENV=development
LOG_LEVEL=INFO
SENTRY_DSN=

# NYC Open Data (Socrata) app token: https://data.cityofnewyork.us/profile/edit/developer_settings
NYC_OPEN_DATA_APP_TOKEN=

# NYC Geoclient API key: https://api-portal.nyc.gov/
GEOCLIENT_API_KEY=

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tenanttrack

# LLM provider for the AI agent
LLM_API_KEY=
LLM_MODEL=gpt-5.4-mini

# Alerts (leave empty to disable)
SMTP_URL=
SMS_API_KEY=
